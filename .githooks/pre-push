#!/bin/sh
# AXIOM pre-push: fast repo guards, then the tests affected since origin/main.
# Installed by: node scripts/install-hooks.mjs  (sets core.hooksPath=.githooks)
# Skip once with: AXIOM_SKIP_PREPUSH=1 git push   (or git push --no-verify)
set -eu

if [ "${AXIOM_SKIP_PREPUSH:-}" = "1" ]; then
  echo "pre-push: AXIOM_SKIP_PREPUSH=1, skipping" >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

node scripts/run-guards.mjs --fast

if command -v pnpm >/dev/null 2>&1; then
  pnpm exec vitest run --changed origin/main --reporter=dot
else
  echo "pre-push: pnpm not on PATH, skipping vitest --changed" >&2
fi
