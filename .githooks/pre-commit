#!/bin/sh
# AXIOM pre-commit: lint what is staged, then the fast repo guards.
# Installed by: node scripts/install-hooks.mjs  (sets core.hooksPath=.githooks)
# Bypass once with: git commit --no-verify
set -eu

cd "$(git rev-parse --show-toplevel)"

if command -v pnpm >/dev/null 2>&1; then
  pnpm exec biome check --staged --no-errors-on-unmatched
else
  echo "pre-commit: pnpm not on PATH, skipping biome" >&2
fi

node scripts/run-guards.mjs --fast --quiet
