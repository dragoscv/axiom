{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "command": "axiom gate --stdin --fail-open --format auto",
        "bash": "axiom gate --stdin --fail-open --format auto",
        "powershell": "axiom.cmd gate --stdin --fail-open --format auto; exit $LASTEXITCODE",
        "timeoutSec": 15
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "axiom gate --stdin --post --format auto",
        "bash": "axiom gate --stdin --post --format auto",
        "powershell": "axiom.cmd gate --stdin --post --format auto; exit $LASTEXITCODE",
        "timeoutSec": 15
      }
    ]
  }
}
