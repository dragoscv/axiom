{
  "name": "@codai/axiom-checks",
  "version": "2.1.0",
  "description": "Predicate registry, fact providers and profiles for the AXIOM checks engine",
  "license": "MIT",
  "author": "Dragos Catalin Vladulescu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscv/axiom.git",
    "directory": "packages/checks"
  },
  "homepage": "https://github.com/dragoscv/axiom#readme",
  "bugs": {
    "url": "https://github.com/dragoscv/axiom/issues"
  },
  "keywords": [
    "axiom",
    "policy",
    "checks",
    "predicates",
    "secrets",
    "guard"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codai/axiom-canon": "workspace:*",
    "@codai/axiom-schema": "workspace:*",
    "@marcbachmann/cel-js": "catalog:",
    "picomatch": "catalog:",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "@cedar-policy/cedar-wasm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
