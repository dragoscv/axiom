{
  "name": "@codai/axiom-axm",
  "version": "3.0.0",
  "description": "AXIOM `.axm` front-end: Chevrotain lexer + CST parser that compiles the .axm DSL 1:1 into a Plan, with position-bearing diagnostics and a deterministic inverse printer — plus the `.axm` language server (`@codai/axiom-axm/lsp`, bin `axm-lsp`)",
  "license": "MIT",
  "author": "Dragos Catalin Vladulescu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscv/axiom.git",
    "directory": "packages/axm"
  },
  "homepage": "https://github.com/dragoscv/axiom#readme",
  "bugs": {
    "url": "https://github.com/dragoscv/axiom/issues"
  },
  "keywords": [
    "axiom",
    "dsl",
    "parser",
    "chevrotain",
    "axm",
    "lsp",
    "language-server"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/lsp-main.js",
    "./src/lsp/main.ts"
  ],
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "axm-lsp": "./dist/lsp-main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lsp": {
      "types": "./dist/lsp.d.ts",
      "import": "./dist/lsp.js"
    },
    "./lsp/main": "./dist/lsp-main.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codai/axiom-schema": "workspace:*",
    "chevrotain": "catalog:",
    "vscode-languageserver": "catalog:",
    "vscode-languageserver-textdocument": "catalog:"
  },
  "devDependencies": {
    "@codai/axiom-checks": "workspace:*",
    "@codai/axiom-plan": "workspace:*",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
