{
  "name": "@codai/axiom-axm",
  "version": "2.2.1",
  "description": "AXIOM v2 `.axm` front-end: Chevrotain lexer + CST parser that compiles the .axm DSL 1:1 into a Plan, with position-bearing diagnostics and a deterministic inverse printer",
  "license": "MIT",
  "author": "Dragos Catalin Vladulescu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscv/axiom.git",
    "directory": "packages/axm"
  },
  "homepage": "https://github.com/dragoscv/axiom#readme",
  "bugs": {
    "url": "https://github.com/dragoscv/axiom/issues"
  },
  "keywords": [
    "axiom",
    "dsl",
    "parser",
    "chevrotain",
    "axm"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "examples",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codai/axiom-schema": "workspace:*",
    "chevrotain": "catalog:"
  },
  "devDependencies": {
    "@codai/axiom-plan": "workspace:*",
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
