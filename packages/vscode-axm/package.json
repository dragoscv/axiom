{
  "name": "axiom-axm",
  "displayName": "AXIOM .axm — plans for the agent write gate",
  "description": "Language support for AXIOM .axm plans (the transactional write gate for coding agents): diagnostics, completion, hover, outline, formatting and semantic highlighting.",
  "version": "2.0.0",
  "private": true,
  "publisher": "dragoscv",
  "license": "MIT",
  "author": "Dragos Catalin Vladulescu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscv/axiom.git",
    "directory": "packages/vscode-axm"
  },
  "homepage": "https://dragoscv.github.io/axiom/integration/vscode/",
  "bugs": {
    "url": "https://github.com/dragoscv/axiom/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#fbf7ef",
    "theme": "light"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "axiom",
    "axm",
    "plan",
    "lsp",
    "ai agents",
    "mcp",
    "coding agents",
    "write gate",
    "manifest"
  ],
  "qna": "https://github.com/dragoscv/axiom/issues",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.138.0",
    "node": ">=22.14"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:axm"
  ],
  "contributes": {
    "languages": [
      {
        "id": "axm",
        "aliases": [
          "AXIOM plan",
          "axm"
        ],
        "extensions": [
          ".axm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "axm",
        "scopeName": "source.axm",
        "path": "./syntaxes/axm.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json"
        }
      }
    ],
    "configurationDefaults": {
      "[axm]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "tsdown && node scripts/package.mjs"
  },
  "dependencies": {
    "@codai/axiom-axm-lsp": "workspace:*",
    "vscode-languageclient": "catalog:"
  },
  "devDependencies": {
    "@types/vscode": "catalog:",
    "@vscode/vsce": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
