{
  "name": "axiom-axm",
  "displayName": "AXIOM — agent write gate + .axm",
  "description": "AXIOM, the transactional write gate for coding agents, in VS Code: a status bar showing the gate state of the workspace, Doctor / Init / Stats / Explain commands, and full language support for .axm plans (diagnostics, completion, hover, outline, formatting, semantic highlighting).",
  "version": "3.0.0",
  "private": true,
  "publisher": "dragoscv",
  "license": "MIT",
  "author": "Dragos Catalin Vladulescu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscv/axiom.git",
    "directory": "packages/vscode-axm"
  },
  "homepage": "https://dragoscv.github.io/axiom/integration/vscode/",
  "bugs": {
    "url": "https://github.com/dragoscv/axiom/issues"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#fbf7ef",
    "theme": "light"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "axiom",
    "axm",
    "plan",
    "lsp",
    "ai agents",
    "mcp",
    "coding agents",
    "write gate",
    "manifest"
  ],
  "qna": "https://github.com/dragoscv/axiom/issues",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.138.0",
    "node": ">=22.14"
  },
  "type": "module",
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:axm"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace AXIOM spawns no process (no doctor/init/stats/explain) and uses only the bundled .axm language server, never the workspace copy.",
      "restrictedConfigurations": [
        "axiom.path"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "axiom.doctor",
        "title": "Doctor",
        "category": "AXIOM"
      },
      {
        "command": "axiom.init",
        "title": "Init",
        "category": "AXIOM"
      },
      {
        "command": "axiom.stats",
        "title": "Stats",
        "category": "AXIOM"
      },
      {
        "command": "axiom.explainLast",
        "title": "Explain last decision",
        "category": "AXIOM"
      },
      {
        "command": "axiom.refresh",
        "title": "Refresh gate status",
        "category": "AXIOM"
      }
    ],
    "configuration": {
      "title": "AXIOM",
      "properties": {
        "axiom.path": {
          "type": "string",
          "default": "axiom",
          "scope": "machine-overridable",
          "markdownDescription": "The `axiom` CLI to run (name on PATH or absolute path). On Windows `axiom.exe` and the npm `axiom.cmd` shim are found automatically; the shim is run as `node <cli.js>` — never through a shell."
        }
      }
    },
    "languages": [
      {
        "id": "axm",
        "aliases": [
          "AXIOM plan",
          "axm"
        ],
        "extensions": [
          ".axm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "axm",
        "scopeName": "source.axm",
        "path": "./syntaxes/axm.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.json": "json"
        }
      }
    ],
    "configurationDefaults": {
      "[axm]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package": "tsdown && node scripts/package.mjs"
  },
  "dependencies": {
    "@codai/axiom-axm": "workspace:*",
    "vscode-languageclient": "catalog:"
  },
  "devDependencies": {
    "@types/vscode": "catalog:",
    "@vscode/vsce": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
