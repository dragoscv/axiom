{
  "comments": { "lineComment": "//", "blockComment": ["/*", "*/"] },
  "brackets": [["{", "}"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [["{", "}"], ["[", "]"], ["\"", "\""]],
  "folding": {
    "markers": {
      "start": "^\\s*<<([A-Za-z_][A-Za-z0-9_-]*)\\s*$",
      "end": "^([A-Za-z_][A-Za-z0-9_-]*)\\r?$"
    }
  },
  "wordPattern": "[A-Za-z0-9_][A-Za-z0-9_.-]*"
}
