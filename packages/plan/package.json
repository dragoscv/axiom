{
  "name": "@codai/axiom-plan",
  "version": "2.1.0",
  "description": "Plan → ManifestBundle compiler for AXIOM v2: content-addressed artifacts, JCS manifest digest, inline/CAS blob transport, in-toto attestation, bundle verification and manifest diff",
  "license": "MIT",
  "author": "Dragos Catalin Vladulescu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscv/axiom.git",
    "directory": "packages/plan"
  },
  "homepage": "https://github.com/dragoscv/axiom#readme",
  "bugs": {
    "url": "https://github.com/dragoscv/axiom/issues"
  },
  "keywords": [
    "axiom",
    "manifest",
    "content-addressed",
    "codegen",
    "agent"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.14"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codai/axiom-canon": "workspace:*",
    "@codai/axiom-schema": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
