{
  "name": "@codai/axiom-axm-lsp",
  "version": "2.7.0",
  "description": "DEPRECATED (3.0): the .axm language server moved into @codai/axiom-axm (`@codai/axiom-axm/lsp`, bin `axm-lsp`). This package only re-exports it for 3.x.",
  "license": "MIT",
  "author": "Dragos Catalin Vladulescu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoscv/axiom.git",
    "directory": "packages/axm-lsp"
  },
  "homepage": "https://github.com/dragoscv/axiom#readme",
  "bugs": {
    "url": "https://github.com/dragoscv/axiom/issues"
  },
  "keywords": [
    "axiom",
    "lsp",
    "language-server",
    "axm"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "bin": {
    "axiom-axm-lsp": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main": "./dist/main.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepack": "node ../../scripts/gen-third-party-notices.mjs --package packages/axm-lsp",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@codai/axiom-axm": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
