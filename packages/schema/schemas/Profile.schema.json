{
  "$id": "https://axiom.dev/schemas/v2/Profile.schema.json",
  "title": "Profile",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "axiom.dev/v2"
    },
    "kind": {
      "type": "string",
      "const": "Profile"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "predicate": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*\\.[a-zA-Z][a-zA-Z0-9]*$"
          },
          "params": {
            "$ref": "#/$defs/__schema0"
          },
          "severity": {
            "default": "error",
            "type": "string",
            "enum": [
              "error",
              "warn",
              "info"
            ]
          }
        },
        "required": [
          "id",
          "predicate",
          "params"
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "maxArtifacts": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxTotalBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxBlobBytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "facts": {
      "default": {},
      "type": "object",
      "properties": {
        "allowRepo": {
          "default": true,
          "type": "boolean"
        },
        "allowGuards": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "checks"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
