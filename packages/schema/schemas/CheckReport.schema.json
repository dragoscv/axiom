{
  "$id": "https://axiom.dev/schemas/v2/CheckReport.schema.json",
  "title": "CheckReport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "axiom.dev/v2"
    },
    "kind": {
      "type": "string",
      "const": "CheckReport"
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256:<64 lowercase hex>"
    },
    "profile": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warn",
              "info"
            ]
          },
          "predicate": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Relative POSIX path, NFC, no reserved names"
          },
          "facts": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "id",
          "severity",
          "predicate",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "factsDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256:<64 lowercase hex>"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "skipped",
              "error"
            ]
          },
          "ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "status",
          "ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "manifestDigest",
    "profile",
    "verdict",
    "findings",
    "factsDigest",
    "durationMs",
    "providers"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
