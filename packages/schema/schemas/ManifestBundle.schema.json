{
  "$id": "https://axiom.dev/schemas/v2/ManifestBundle.schema.json",
  "title": "ManifestBundle",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "type": "string",
          "const": "axiom.dev/v2"
        },
        "kind": {
          "type": "string",
          "const": "Manifest"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "planDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "sha256:<64 lowercase hex>"
        },
        "artifacts": {
          "minItems": 1,
          "maxItems": 2000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "description": "Relative POSIX path, NFC, no reserved names"
              },
              "op": {
                "type": "string",
                "enum": [
                  "create",
                  "overwrite",
                  "delete"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "0644",
                  "0755"
                ]
              },
              "digest": {
                "type": "object",
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "description": "Lowercase hex-encoded sha256"
                  }
                },
                "required": [
                  "sha256"
                ],
                "additionalProperties": false
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "origin": {
                "type": "string",
                "enum": [
                  "inline",
                  "template",
                  "cas",
                  "ref",
                  "patch"
                ]
              }
            },
            "required": [
              "path",
              "op",
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "predicate": {
                "type": "string",
                "pattern": "^[a-z][a-zA-Z0-9]*\\.[a-zA-Z][a-zA-Z0-9]*$"
              },
              "params": {
                "$ref": "#/$defs/__schema0"
              },
              "severity": {
                "default": "error",
                "type": "string",
                "enum": [
                  "error",
                  "warn",
                  "info"
                ]
              }
            },
            "required": [
              "id",
              "predicate",
              "params"
            ],
            "additionalProperties": false
          }
        },
        "toolchain": {
          "type": "object",
          "properties": {
            "axiom": {
              "type": "string",
              "minLength": 1
            },
            "emitters": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "axiom",
            "emitters"
          ],
          "additionalProperties": false
        },
        "counter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "preImage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "description": "Relative POSIX path, NFC, no reserved names"
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "description": "Lowercase hex-encoded sha256"
                  },
                  {
                    "type": "string",
                    "const": "absent"
                  }
                ]
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "name",
        "profile",
        "planDigest",
        "artifacts",
        "checks",
        "toolchain"
      ],
      "additionalProperties": false
    },
    "manifestDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256:<64 lowercase hex>"
    },
    "attestation": {
      "type": "object",
      "properties": {
        "_type": {
          "type": "string",
          "const": "https://in-toto.io/Statement/v1"
        },
        "subject": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "digest": {
                "type": "object",
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "description": "Lowercase hex-encoded sha256"
                  }
                },
                "required": [
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "digest"
            ],
            "additionalProperties": false
          }
        },
        "predicateType": {
          "type": "string",
          "format": "uri"
        },
        "predicate": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "_type",
        "subject",
        "predicateType",
        "predicate"
      ],
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "properties": {
        "payloadType": {
          "type": "string",
          "const": "application/vnd.in-toto+json"
        },
        "payload": {
          "type": "string",
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "keyid": {
                "type": "string"
              },
              "sig": {
                "type": "string",
                "format": "base64",
                "contentEncoding": "base64",
                "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
              }
            },
            "required": [
              "sig"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "payloadType",
        "payload",
        "signatures"
      ],
      "additionalProperties": false
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "payloadType": {
            "type": "string",
            "const": "application/vnd.axiom.manifest+json"
          },
          "payload": {
            "type": "string",
            "format": "base64",
            "contentEncoding": "base64",
            "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
          },
          "signatures": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "keyid": {
                  "type": "string"
                },
                "sig": {
                  "type": "string",
                  "format": "base64",
                  "contentEncoding": "base64",
                  "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
                }
              },
              "required": [
                "sig"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "payloadType",
          "payload",
          "signatures"
        ],
        "additionalProperties": false
      }
    },
    "blobs": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$",
        "description": "sha256:<64 lowercase hex>"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "encoding": {
            "type": "string",
            "enum": [
              "utf8",
              "base64"
            ]
          },
          "data": {
            "type": "string"
          }
        },
        "required": [
          "encoding",
          "data"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "manifest",
    "manifestDigest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
