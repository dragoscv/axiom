{
  "$id": "https://axiom.dev/schemas/v2/Manifest.schema.json",
  "title": "Manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "axiom.dev/v2"
    },
    "kind": {
      "type": "string",
      "const": "Manifest"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "planDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256:<64 lowercase hex>"
    },
    "artifacts": {
      "minItems": 1,
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Relative POSIX path, NFC, no reserved names"
          },
          "op": {
            "type": "string",
            "enum": [
              "create",
              "overwrite",
              "delete"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "0644",
              "0755"
            ]
          },
          "digest": {
            "type": "object",
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "Lowercase hex-encoded sha256"
              }
            },
            "required": [
              "sha256"
            ],
            "additionalProperties": false
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "origin": {
            "type": "string",
            "enum": [
              "inline",
              "template",
              "cas",
              "ref"
            ]
          }
        },
        "required": [
          "path",
          "op",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "predicate": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9]*\\.[a-zA-Z][a-zA-Z0-9]*$"
          },
          "params": {
            "$ref": "#/$defs/__schema0"
          },
          "severity": {
            "default": "error",
            "type": "string",
            "enum": [
              "error",
              "warn",
              "info"
            ]
          }
        },
        "required": [
          "id",
          "predicate",
          "params"
        ],
        "additionalProperties": false
      }
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "axiom": {
          "type": "string",
          "minLength": 1
        },
        "emitters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "axiom",
        "emitters"
      ],
      "additionalProperties": false
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "name",
    "profile",
    "planDigest",
    "artifacts",
    "checks",
    "toolchain"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
