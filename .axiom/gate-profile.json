{
  "deny": [
    ".git/**",
    ".axiom/**",
    ".github/hooks/**",
    "pnpm-lock.yaml",
    "**/*.lock",
    ".env",
    ".env.*",
    "**/.env",
    "**/.env.*",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**"
  ],
  "noSecrets": true,
  "pii": false,
  "maxBytes": 262144,
  "steer": "hint",
  "record": true,
  "commands": {
    "pack": "house"
  },
  "coordination": {
    "marksDir": "~/.codai/coord/marks",
    "leasesDir": "~/.codai/coord/leases",
    "slotsRoot": "${env:CODAI_WT_ROOT:-E:/gh/.wt}",
    "exemptVia": [
      "agentq\\.ps1"
    ]
  },
  "git": {
    "cleanTreeFor": [
      "deploy"
    ],
    "untracked": true
  },
  "mode": "warn",
  "override": true,
  "outside": "allow",
  "hard": [
    "house.forcePush",
    "house.resetHard",
    "house.cleanForce",
    "house.worktreeRemoveForce"
  ]
}
